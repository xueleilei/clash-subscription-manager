APP_IMAGE=clash-subscription-manager:local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
PUBLIC_BASE_URL=https://clash.example.com
COOKIE_SECURE=true
# Existing MySQL: dedicated database/account. For Compose MySQL this URL is overridden.
DB_URL=jdbc:mysql://host.docker.internal:3306/clashsub?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=clashsub
DB_NAME=clashsub
DB_PASSWORD_FILE=./secrets/db_password
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_FILE=./secrets/admin_password
APP_ENCRYPTION_KEY_FILE=./secrets/encryption.key
# Empty by default. Only allow a specific private upstream when needed (CIDR notation).
UPSTREAM_PRIVATE_ALLOWLIST=
TRUSTED_OUTBOUND_PROXY_URL=
# Host YAML catalog mounted read-only by Compose; recreate the app after editing.
NODE_REGIONS_FILE=./config/node-regions.yaml
